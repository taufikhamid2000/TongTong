# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses row-level security. Never expose to the client,
# never prefix with NEXT_PUBLIC_. Needed for admin-side operations
# (e.g. verifying an operator's license before they can list a route).
SUPABASE_SERVICE_ROLE_KEY=
